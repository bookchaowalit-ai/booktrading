# Environment Configuration for Trading Bot System
# Copy this file to .env and fill in your values

# ============================================================
# SECURITY (Required - change before deploying to production)
# ============================================================
# 32+ character random string used for AES-256-GCM API key encryption
ENCRYPTION_KEY=change_me_to_a_secure_random_32char_string

# Database password (used by both postgres service and backend)
DB_PASSWORD=trading123

# Redis password
REDIS_PASSWORD=redis_secret

# Allowed CORS origin for the browser frontend
FRONTEND_URL=http://localhost:3000

# ============================================================
# Exchange Provider Selection
# ============================================================
EXCHANGE_PROVIDER=binance_th

# Binance Global API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_USE_TESTNET=true

# Binance Thailand API Credentials
BINANCE_TH_API_KEY=your_binance_th_api_key_here
BINANCE_TH_API_SECRET=your_binance_th_api_secret_here

# Bitkub API Credentials (Thai Exchange)
BITKUB_API_KEY=your_bitkub_api_key_here
BITKUB_API_SECRET=your_bitkub_api_secret_here
BITKUB_USE_TESTNET=false

# ============================================================
# Infrastructure
# ============================================================
# Redis Configuration (when running outside Docker)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Backend Server Ports
SERVER_PORT=8080
WS_PORT=8081
GRPC_PORT=9000

# Strategy Service Configuration
RSI_PERIOD=14
EMA_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
MIN_SIGNAL_STRENGTH=0.5
SYMBOLS=BTCUSDT,ETHUSDT

# ============================================================
# Frontend
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STRATEGY_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws
