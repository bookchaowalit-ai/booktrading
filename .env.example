# Environment Configuration for Trading Bot System
# Copy this file to .env and fill in your values

# ============================================================
# SECURITY (Required - MUST be changed before deploying)
# ============================================================
# 32+ character random string used for AES-256-GCM API key encryption
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=

# Database password (MUST be set — no default provided)
DB_PASSWORD=

# Redis password (MUST be set — no default provided)
REDIS_PASSWORD=

# Allowed CORS origin for the browser frontend (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000

# First admin account credentials (created on first startup)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Admin

# ============================================================
# Telegram Bot (Optional — enables /status /balance /pnl commands)
# ============================================================
TELEGRAM_BOT_TOKEN=

# ============================================================
# Exchange Provider Selection
# ============================================================
EXCHANGE_PROVIDER=binance_th

# Binance Global API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_USE_TESTNET=true

# Binance Thailand API Credentials
BINANCE_TH_API_KEY=your_binance_th_api_key_here
BINANCE_TH_API_SECRET=your_binance_th_api_secret_here

# Bitkub API Credentials (Thai Exchange)
BITKUB_API_KEY=your_bitkub_api_key_here
BITKUB_API_SECRET=your_bitkub_api_secret_here
BITKUB_USE_TESTNET=false

# ============================================================
# DEX/AMM Trading (Optional — Web3/DeFi trading)
# ============================================================
# Enable DEX trading (true/false)
DEX_ENABLED=false

# Default DEX provider (uniswap_v2, uniswap_v3, pancakeswap, sushiswap)
DEX_PROVIDER=uniswap_v3

# Default chain ID (1=Ethereum, 42161=Arbitrum, 8453=Base, 56=BSC, 137=Polygon)
DEX_CHAIN_ID=42161

# Slippage tolerance percentage (e.g., 0.5 = 0.5%)
DEX_SLIPPAGE_PCT=0.5

# Max gas limit per transaction
DEX_GAS_LIMIT=500000

# Max price impact warning threshold (%)
DEX_MAX_PRICE_IMPACT=3.0

# RPC URLs for each chain (at least one must be set)
ETH_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
BSC_RPC_URL=https://bsc-dataseed.binance.org

# ============================================================
# Infrastructure
# ============================================================
# Redis Configuration (when running outside Docker)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Backend Server Ports
SERVER_PORT=8080
WS_PORT=8081
GRPC_PORT=9000

# Strategy Service Configuration
RSI_PERIOD=14
EMA_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
MIN_SIGNAL_STRENGTH=0.5
SYMBOLS=BTCUSDT,ETHUSDT

# ============================================================
# Real Trading Configuration (Binance TH)
# ============================================================
# Symbol for real grid trading (Binance TH only supports THB pairs)
REAL_SYMBOLS=BTCTHB

# Disable paper trading bot to reduce log noise (default: true)
DISABLE_PAPER_BOT=true

# Auth token for strategy API (leave empty for dev, set for production)
AUTH_TOKEN=

# ============================================================
# Polymarket Paper Bot — Safety & Readiness Config
# ============================================================
# IMPORTANT: These defaults are SAFE-BY-DEFAULT.
# Do NOT change POLY_DRY_RUN=false until RUNBOOK micro-live
# prerequisites are fully met (see strategy/RUNBOOK.md).
#
# Current mode: CAPITAL PROTECTION — all values conservative.

# Dry-run mode: log would-trade entries without executing positions
# true = safe (no real trades) | false = executes paper positions
POLY_DRY_RUN=true

# Max concurrent active positions (conservative: 3)
POLY_MAX_POSITIONS=3

# Position size per trade in USDC (conservative: $1)
POLY_POSITION_SIZE=1

# Daily loss limit in USDC (stop trading if daily PnL hits -$2)
POLY_DAILY_LOSS_LIMIT=2

# Max drawdown from peak (0.05 = 5% — triggers kill switch)
POLY_MAX_DRAWDOWN=0.05

# Max consecutive losses before kill switch
POLY_MAX_CONSEC_LOSSES=3

# Market blocklist: comma-separated keywords to EXCLUDE
# Matches against event title + slug (case-insensitive)
POLY_MARKET_BLOCKLIST=politics,sports,entertainment,celebrities

# Market allowlist: comma-separated keywords to INCLUDE (empty = allow all)
# If set, ONLY events matching these keywords pass (after blocklist)
POLY_MARKET_ALLOWLIST=

# Bankroll (paper trading starting capital in USDC)
POLY_BANKROLL=100

# Scan interval in seconds (how often to check for new markets)
POLY_SCAN_INTERVAL=300

# ============================================================
# Polymarket Prediction Markets (Research & Analysis)
# ============================================================
# Enable Polymarket research module
POLYMARKET_ENABLED=true

# Polymarket API endpoints (public, no auth required for market data)
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com

# ============================================================
# Market Intelligence (Multi-Market Scanner)
# ============================================================
# Enable market intelligence module
MARKET_INTEL_ENABLED=true

# Enabled sources (comma-separated): crypto, prediction, stocks, macro
MARKET_INTEL_SOURCES=crypto,prediction,stocks,macro

# Crypto symbols to track (Binance pairs)
MARKET_INTEL_CRYPTO_SYMBOLS=BTCTHB,ETHTHB,BTCUSDT,ETHUSDT

# Stock symbols to track (Yahoo Finance — US + Thai .BK)
MARKET_INTEL_STOCK_SYMBOLS=SPY,QQQ,AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,META,PTT.BK,AOT.BK,SCB.BK

# ============================================================
# Internal Service URLs (Docker networking)
# These are used by docker-compose for service-to-service communication
# ============================================================
BACKEND_URL=http://backend:8080
STRATEGY_URL=http://strategy:8000

# ============================================================
# TLS/HTTPS (Optional)
# Option 1: Use Caddy reverse proxy (recommended — see docker-compose.prod.yml)
# Option 2: Provide your own cert files directly to the backend
# ============================================================
# Path to TLS certificate file (PEM format)
TLS_CERT_FILE=
# Path to TLS private key file (PEM format)
TLS_KEY_FILE=

# For production with Caddy (Let's Encrypt)
APP_DOMAIN=
LETSENCRYPT_EMAIL=

# ============================================================
# Frontend - Public browser-accessible URLs
# Leave NEXT_PUBLIC_API_URL and NEXT_PUBLIC_STRATEGY_URL empty
# to use the Next.js proxy (recommended when running in Docker)
# For local dev without Docker, set to http://localhost:8080 etc.
# ============================================================
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STRATEGY_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws
